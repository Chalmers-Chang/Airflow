# Copy to .env and edit. Never commit .env (gitignored).
#
#   cp .env.example .env
#   # edit paths / uid / username
#   docker compose up -d
#
# Required for compose to start (volume mount). Empty ICLOUD_AIRFLOW_DIR fails with:
#   invalid spec: :/opt/airflow/icloud:ro: empty section between colons

AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.8
AIRFLOW_PROJ_DIR=../..

# Host uid so logs/ are not owned by root. On macOS usually: id -u
AIRFLOW_UID=501

# Absolute path to the iCloud Drive "airflow" folder on this Mac.
# Example: /Users/YOUR_USER/Library/Mobile Documents/com~apple~CloudDocs/airflow
ICLOUD_AIRFLOW_DIR=/Users/YOUR_USER/Library/Mobile Documents/com~apple~CloudDocs/airflow

# Extra pip packages for DAGs (reinstalled on every container start; local-only).
_PIP_ADDITIONAL_REQUIREMENTS=pypdf==4.3.1 caldav==1.3.9 icalendar==5.0.14

# import_apple_calendar: worker SSH → this Mac to download cloud-only iCloud PDFs.
# Mac username allowed for Remote Login (System Settings → Sharing → Remote Login).
IMPORT_APPLE_CALENDAR_SSH_USER=YOUR_MACOS_USERNAME
# Absolute host path to the materialize script (SSH runs on the Mac, not in the container).
IMPORT_APPLE_CALENDAR_MATERIALIZE_SCRIPT=/Users/YOUR_USER/Repo/Airflow/dags/import_apple_calendar/scripts/materialize_icloud.sh
# Optional; Docker Desktop default is fine.
# IMPORT_APPLE_CALENDAR_SSH_HOST=host.docker.internal
